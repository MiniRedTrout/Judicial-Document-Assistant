# Скопируйте в .env в корне
LLM_API_BASE=https://api.cerebras.ai/v1
LLM_MODEL=gpt-oss-120b
LLM_API_KEY=
LLM_TIMEOUT=60
LLM_MAX_CHARS=60000
LLM_JSON_MODE=true

# Почта по умолчанию отключена.
MAIL_ENABLED=false
MAIL_AUTO_SEND=false
MAIL_SMTP_HOST=smtp.mail.ru
MAIL_SMTP_PORT=465
MAIL_SECURITY=ssl
MAIL_USER=
MAIL_PASS=
MAIL_FROM=
MAIL_LAWYER=
MAIL_TIMEOUT=30

# Windows: папка с pdfinfo.exe и pdftoppm.exe. Linux/Docker: оставить пустым.

POPPLER_PATH=
PDF_EXTRACTOR_OCR_ENGINE=easyocr
PDF_EXTRACTOR_OCR_USE_GPU=false
PDF_EXTRACTOR_OCR_DPI=300

# Опциональный Camelot отключён по умолчанию; основной OCR остаётся включён.
PDF_EXTRACTOR_ENABLE_TABLE_EXTRACTION=false